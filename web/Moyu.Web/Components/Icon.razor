@* 粗黑描边的小图标，64×64 画布。名称见下面 switch。 *@
<svg class="icon @Class" viewBox="0 0 64 64" aria-hidden="true">
    @switch (Name)
    {
        case "rod":
            <path d="M10 56 L50 10" class="line" stroke-width="9" />
            <path d="M10 56 L50 10" stroke="#e3ea6c" stroke-width="4" fill="none" stroke-linecap="round" />
            <circle cx="22" cy="44" r="8" fill="#fbf3e3" class="line" />
            <circle cx="22" cy="44" r="3" fill="#b98ed6" />
            break;
        case "hand":
            <path d="M14 46 C8 34 12 22 20 24 C20 14 30 12 32 22 C34 12 44 14 44 24 C52 20 58 32 50 46 Z" fill="#cfa6ea" class="line" />
            break;
        case "pole":
            <path d="M6 50 L58 22" class="line" stroke-width="8" />
            <path d="M6 50 L58 22" stroke="#e3ea6c" stroke-width="3.5" fill="none" stroke-linecap="round" />
            <path d="M28 60 L40 34 M44 60 L32 34" class="line" />
            break;
        case "basket":
            <path d="M18 26 C18 8 46 8 46 26" class="line" fill="none" />
            <path d="M8 26 H56 L50 56 H14 Z" fill="#e3ea6c" class="line" />
            <path d="M22 36 V48 M32 36 V48 M42 36 V48 M18 42 H46" class="line" stroke-width="3" />
            break;
        case "star":
            <path d="M32 6 L40 23 L58 25 L45 38 L48 57 L32 48 L16 57 L19 38 L6 25 L24 23 Z" fill="#c79be6" class="line" stroke-linejoin="round" />
            break;
        case "list":
            <rect x="12" y="10" width="40" height="48" rx="6" fill="#fbf3e3" class="line" />
            <rect x="24" y="5" width="16" height="10" rx="3" fill="#fbf3e3" class="line" />
            <path d="M21 28 H43 M21 38 H43 M21 48 H35" class="line" />
            break;
        case "gear":
            <path d="M32 6 l6 7 9-2 2 9 8 5-4 8 4 8-8 5-2 9-9-2-6 7-6-7-9 2-2-9-8-5 4-8-4-8 8-5 2-9 9 2z" fill="#c79be6" class="line" stroke-linejoin="round" />
            <circle cx="32" cy="32" r="9" fill="#fbf3e3" class="line" />
            break;
        case "people":
            <circle cx="22" cy="22" r="9" fill="#fbf3e3" class="line" />
            <circle cx="42" cy="22" r="9" fill="#fbf3e3" class="line" />
            <path d="M6 54 C6 38 38 38 38 54 Z" fill="#fbf3e3" class="line" />
            <path d="M28 40 C34 36 58 38 58 54 H38" fill="#fbf3e3" class="line" />
            break;
        case "mute":
            <path d="M8 24 H18 L32 12 V52 L18 40 H8 Z" fill="#fbf3e3" class="line" stroke-linejoin="round" />
            <path d="M42 24 L56 40 M56 24 L42 40" class="line" />
            break;
        case "sound":
            <path d="M8 24 H18 L32 12 V52 L18 40 H8 Z" fill="#fbf3e3" class="line" stroke-linejoin="round" />
            <path d="M40 24 C46 28 46 36 40 40 M46 16 C58 24 58 40 46 48" class="line" fill="none" />
            break;
        case "minus":
            <path d="M16 32 H48" class="line" stroke-width="7" />
            break;
        case "close":
            <path d="M18 18 L46 46 M46 18 L18 46" class="line" stroke-width="7" />
            break;
        case "map":
            <path d="M6 52 L24 26 L36 40 L44 32 L58 52 Z" fill="#a9c96a" class="line" stroke-linejoin="round" />
            <circle cx="46" cy="16" r="7" fill="#f3d24b" class="line" />
            break;
        case "check":
            <path d="M14 34 L27 46 L50 18" class="line" stroke-width="7" fill="none" />
            break;
        case "caret":
            <path d="M14 22 H50 L32 46 Z" fill="#1f1d1a" />
            break;
        case "chevron":
            <path d="M24 14 L42 32 L24 50" class="line" stroke-width="6" fill="none" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
}

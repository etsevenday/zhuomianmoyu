@* 小窗场景（1600×900 画布）。天空不画：真透明（DEC-04）。
   命中：岸=shore（单击选位），水=water（按住拖窗/摸鱼时单击选位），角色=character（按住拖窗）；
   植物、荷叶、竿线等装饰不接指针，点到它们等于点到下面的岸/水或透明处（01 §4）。
   同图房间里：场景主题和底层鱼缸跟房主（Q20），好友的熊也不接指针，点到它们等于点到下面的岸（09 §5）。 *@
<svg class="scene" viewBox="0 0 1600 900" xmlns="http://www.w3.org/2000/svg" data-scene="@SceneSkin" data-map="@Pet.State.MapId">
    @* 设为背景的鱼缸：游戏里最底下的一层，就在原 1600×900 画幅里（03 §3、B1 Q11 答复）。
       缸框沿画幅边界向内画、玻璃不填色（透明）；鱼裁在缸里游；岸、水、装饰、小熊、卡片和底栏都盖在它上面。
       缸框和鱼都不接指针，不改穿透和选位。空缸设为背景只画缸框。 *@
    @if (BackgroundTank != null)
    {
        var bg = BackgroundFish;
        var bgScale = BackgroundScale;
        <g class="bg-tank nohit" data-tank="@BackgroundTank" data-owner="@Session.ShownTankOwner">
            <defs>
                <clipPath id="bg-tank-clip"><rect x="@TankInset" y="@TankInset" width="@(SceneCanvas.Width - 2 * TankInset)" height="@(SceneCanvas.Height - 2 * TankInset)" rx="44" /></clipPath>
            </defs>
            <g class="bg-tank-fish" clip-path="url(#bg-tank-clip)">
                <path d="M@TankInset 118 C 260 104 420 132 640 118 S 1100 106 1300 120 S 1500 112 @(SceneCanvas.Width - TankInset) 118" class="tank-water" fill="none" />
                @for (int i = 0; i < bg.Count; i++)
                {
                    var f = bg[i];
                    var (x, y) = SwimSpot(i);
                    <g class="bg-fish" data-fish="@f.Id" data-len="@f.LengthMm" style="animation-duration:@(9 + i % 5)s;animation-delay:-@(i * 1.7 % 9)s">
                        <Fish Species="@f.SpeciesId" X="x" Y="y" Length="@(f.LengthMm * bgScale)" />
                    </g>
                }
            </g>
            <rect class="bg-tank-frame line" x="@TankInset" y="@TankInset" width="@(SceneCanvas.Width - 2 * TankInset)" height="@(SceneCanvas.Height - 2 * TankInset)" rx="44" fill="none" stroke-width="12" />
        </g>
    }

    @* 岸后的灌木 *@
    <g class="nohit">
        <path d="M-20 560 C-10 470 60 450 110 480 C130 420 220 420 250 470 C290 440 360 460 370 530 L370 560 Z" fill="@P.Bush" class="line" stroke-linejoin="round" />
        <path d="M1180 560 C1190 500 1250 480 1300 500 C1330 450 1420 450 1450 500 C1500 470 1590 480 1620 540 L1620 560 Z" fill="@P.Bush" class="line" stroke-linejoin="round" />
    </g>

    @* 岸：整条连续草岸 *@
    <path data-hit="shore" d="M0 540 C200 528 420 548 640 538 S1100 530 1300 540 S1520 534 1600 540 V600 H0 Z" fill="@P.Shore" class="line" />

    @* 水 *@
    <rect data-hit="water" data-drag-target="pet" x="-10" y="592" width="1620" height="190" fill="@P.Water" class="line" />

    <g class="nohit">
        <path d="M560 760 h60 M840 740 h80 M1480 748 h70 M1000 612 h50 M300 640 h40" class="line" stroke-width="6" />
        @switch (MapIndex)
        {
            case 0:
                @* 荷塘：荷叶与两株荷花 *@
                <path d="M1150 650 m-190 0 a190 52 0 1 0 380 0 a190 52 0 1 0 -380 0 M1150 650 L1110 626" fill="#b5d16f" class="line" />
                <path d="M1120 640 l-30 -10 M1180 640 l30 -12 M1150 670 l0 18" class="line" stroke-width="5" />
                <path d="M1470 640 m-80 0 a80 24 0 1 0 160 0 a80 24 0 1 0 -160 0" fill="#b5d16f" class="line" />
                <path d="M140 600 C138 520 136 470 140 430" class="line" stroke="#7fa64a" stroke-width="14" />
                <path d="M140 600 C138 520 136 470 140 430" stroke="#a9c96a" stroke-width="6" fill="none" />
                <path d="M140 430 C100 430 80 390 96 360 C110 380 120 390 140 395 C130 360 140 330 160 316 C170 340 175 370 168 395 C190 388 200 376 212 360 C224 392 196 430 140 430 Z" fill="#f0a3a8" class="line" stroke-linejoin="round" />
                <path d="M1470 600 C1468 540 1466 500 1470 470" class="line" stroke="#7fa64a" stroke-width="14" />
                <path d="M1470 600 C1468 540 1466 500 1470 470" stroke="#a9c96a" stroke-width="6" fill="none" />
                <path d="M1470 470 C1434 470 1416 436 1430 410 C1442 428 1452 436 1470 440 C1462 410 1470 384 1488 372 C1497 394 1500 420 1494 440 C1514 434 1522 424 1532 410 C1542 438 1518 470 1470 470 Z" fill="#f0a3a8" class="line" stroke-linejoin="round" />
                break;
            case 1:
                @* 溪流：水里一堆灰石 *@
                <path d="M980 720 C960 670 1020 640 1070 660 C1100 630 1170 640 1180 680 C1230 660 1320 680 1320 730 Z" fill="#a8a8ad" class="line" stroke-linejoin="round" />
                <path d="M100 600 C90 560 150 540 190 560 C200 590 180 600 100 600 Z M1440 600 C1440 560 1500 550 1520 580 V600 Z" fill="#a8a8ad" class="line" />
                break;
            default:
                @* 海湾：一段小码头 *@
                <path d="M960 640 H1330 V680 H960 Z" fill="#e2b48f" class="line" />
                <path d="M1000 680 V740 M1290 680 V740 M1060 640 V680 M1130 640 V680 M1200 640 V680 M1270 640 V680" class="line" stroke-width="8" />
                <path d="M110 600 V510 M170 600 V520 M1460 600 V512 M1490 600 V520" class="line" stroke-width="12" />
                break;
        }
    </g>

    <SceneDecor Skin="@SceneSkin" />

    @if (Session.Room is { } room)
    {
        @foreach (var m in room.Members.Where(m => !m.IsSelf && m.Spot.HasValue))
        {
            @* 好友各穿各的（Q20）；一直有个轻微的待机起伏，收到动作或收获时再播一下短动作 *@
            <g class="friend nohit" data-member="@m.Id" style="animation-delay:-@(m.JoinOrder * 0.7 % 2.6)s">
                <Bear Preview Mode="m.Mode" Spot="m.Spot!.Value" WaterColor="@P.Water" Character="@m.Character" Rod="@m.Rod" Glove="@m.Glove" />
            </g>
        }
    }

    @if (Spot is { } spot)
    {
        <Bear Mode="Mode" Spot="spot" WaterColor="@P.Water" Character="@Equipped(SkinCategory.Character)" Rod="@Equipped(SkinCategory.Rod)" Glove="@Equipped(SkinCategory.Glove)" />
    }

    @if (Session.Room is { } r)
    {
        @* 头顶名字：本人写"我"，房主多一个"房主"牌（TXT-ROOM-017） *@
        @* 同一区域里按左右顺序一高一低错开，相邻的名字牌不互相压住 *@
        var tagged = r.Members.Where(m => m.Spot.HasValue).OrderBy(m => m.Mode.Area()).ThenBy(m => m.Spot!.Value.X).ToList();
        @for (int i = 0; i < tagged.Count; i++)
        {
            var m = tagged[i];
            var host = m.Id == r.HostId;
            var w = NameWidth(m.Name) + (host ? 100 : 0);
            var rank = tagged.Take(i).Count(o => o.Mode.Area() == m.Mode.Area());
            <g class="name-tag nohit" data-member="@m.Id" data-host="@(host ? "true" : "false")" transform="translate(@F(m.Spot!.Value.X) @F(m.Spot.Value.Y - 372 - rank % 2 * 62))">
                <rect x="@F(-w / 2)" y="-30" width="@F(w)" height="56" rx="28" class="line" stroke-width="5" />
                <text x="@F(host ? -50 : 0)" y="12" text-anchor="middle">@m.Name</text>
                @if (host)
                {
                    <g class="host-badge">
                        <rect x="@F(w / 2 - 96)" y="-22" width="88" height="40" rx="20" />
                        <text x="@F(w / 2 - 52)" y="9" text-anchor="middle">房主</text>
                    </g>
                }
            </g>
        }
    }

    @if (Session.NoRoomAt is { } at)
    {
        @* 放不下：在点击处冒一下【文字占位，B0 Q5】 *@
        <g class="noroom nohit" transform="translate(@F(at.X) @F(at.Y))">
            <rect x="-130" y="-120" width="260" height="70" rx="35" fill="#fbf3e3" class="line" />
            <text x="0" y="-72" text-anchor="middle" class="noroom-text">这里放不下</text>
            <path d="M-20 -14 L20 14 M20 -14 L-20 14" class="line" stroke-width="7" />
        </g>
    }
</svg>

@code {
    [Parameter, EditorRequired] public PetSession Session { get; set; } = null!;

    private PetController Pet => Session.Pet;
    private FishingMode Mode => Pet.State.Mode;
    private ScenePoint? Spot => Pet.State.Spot;
    private int MapIndex => Math.Max(0, Pet.Maps.All.ToList().FindIndex(m => m.Id == Pet.State.MapId));

    /// <summary>三张占位地图只用配色区分：荷塘青绿水（DEC-05）、溪流青蓝、海湾浅蓝（03 §4 方向）。</summary>
    private Palette P => MapIndex switch
    {
        0 => new Palette("#7dbba5", "#a9c96a", "#9cc463"),
        1 => new Palette("#7fbfd0", "#b3c97a", "#8fbf6a"),
        _ => new Palette("#9fd3e3", "#e8d7a8", "#a7c977"),
    };

    private string Equipped(SkinCategory c) => Session.Play?.EquippedId(c) ?? Session.Skins.BaseOf(c).Id;
    private string SceneSkin => Session.ShownSceneSkin;

    /// <summary>缸框离画幅边界多远：框的粗描边整个落在画幅里面。</summary>
    private const double TankInset = 10;

    private string? BackgroundTank => Session.ShownTankId;

    private List<FishRecord> BackgroundFish => Session.ShownTankFish;

    /// <summary>
    /// 背景鱼每毫米画多少单位：缸里所有鱼共用一个比例（03 §3 允许整体适配最长那条、不能逐条归一），
    /// 最长的约占场景宽四分之一；只有小鱼时不放大过头。
    /// </summary>
    private double BackgroundScale => Math.Min(1.0, 400.0 / Math.Max(1, BackgroundFish.Select(f => f.LengthMm).DefaultIfEmpty(1).Max()));

    /// <summary>
    /// 第 i 条鱼游的位置：按编号固定，刷新不乱跳。都放在水面线以下、岸以上的透明处
    /// （再往下会被岸和水盖住，这是 03 §3 要的遮挡，但放那儿就看不见了）。
    /// </summary>
    private static (double X, double Y) SwimSpot(int i) => (220 + (i * 337) % 1160, 190 + (i * 71) % 270);

    /// <summary>名字牌的宽度：按字数估，中文一个字约 34 单位。</summary>
    private static double NameWidth(string name) => 40 + name.Length * 34;

    private sealed record Palette(string Water, string Shore, string Bush);

    private static string F(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}

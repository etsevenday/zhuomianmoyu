@* 网页版的模拟桌面：1920×1080 逻辑像素，按视口等比缩放（js/pet.js fit）。
   壁纸、桌面图标、记事本、任务栏都是"下层应用"，用来验证小窗透明区穿透（UI-02、TECH-03）。 *@
@implements IDisposable
@inject PetSession Session
@inject IJSRuntime JS

@if (_pc)
{
    @* PC 版：Electron 外壳的透明窗口就是小窗本身，没有假桌面、记事本、任务栏和试玩说明（B4） *@
    <div class="pc-root" @ref="_desktop">
        @if (_loaded && !Pet.State.Closed)
        {
            @if (Pet.State.Collapsed)
            {
                <div id="avatar" class="avatar" data-hit="avatar" title="恢复">
                    <img src="img/icon.svg" alt="" draggable="false" />
                </div>
            }
            else
            {
                <PetWindow Session="Session" OnCommit="Commit" Pc="true" />
            }
        }
    </div>
    return;
}

<div class="viewport">
    <div class="desktop" @ref="_desktop" @onclick="ClearIconSelection">
        <div class="icons">
            @foreach (var icon in Icons)
            {
                @* "桌面摸鱼"图标是游戏的打开入口，属于管理操作，点它不算工作输入（01 §1） *@
                <button class="desk-icon @(_selectedIcon == icon.Id ? "sel" : "")" data-game-ui="@(icon.Id == "pet" ? "open" : null)"
                        @onclick="() => SelectIcon(icon.Id)" @onclick:stopPropagation="true"
                        @ondblclick="() => OpenIcon(icon.Id)">
                    <span class="glyph @icon.Id"></span>
                    <span class="label">@icon.Label</span>
                </button>
            }
        </div>

        @if (_notepadOpen)
        {
            <div id="notepad" class="app-window" style="left:@(_notepadX)px;top:@(_notepadY)px" @onclick:stopPropagation="true">
                <div class="app-title" data-hit="app-title" data-drag-target="notepad">
                    <span>记事本 — 今天的工作.txt</span>
                    <button class="app-close" title="关闭" @onclick="() => _notepadOpen = false">×</button>
                </div>
                <textarea spellcheck="false">@NotepadText</textarea>
            </div>
        }

        @if (_loaded && !Pet.State.Closed)
        {
            @if (Pet.State.Collapsed)
            {
                @* 收起：缩成圆头像留在原处，单击恢复，可拖动，拖完松开不恢复（B0 Q1 答复 A） *@
                <div id="avatar" class="avatar" data-hit="avatar" data-drag-target="avatar" title="恢复"
                     style="left:@Px(Pet.AvatarPosition.X);top:@Px(Pet.AvatarPosition.Y);width:@Px(Pet.Layout.AvatarSize);height:@Px(Pet.Layout.AvatarSize)"
                     @onclick:stopPropagation="true">
                    <img src="img/icon.svg" alt="" draggable="false" />
                </div>
            }
            else
            {
                <PetWindow Session="Session" OnCommit="Commit" />
            }
        }

        @if (_dev)
        {
            <div class="dev-strip" @onclick:stopPropagation="true">
                <b>开发</b>
                <button @onclick="() => Session.DevInjectFishAsync(1)">注入鱼</button>
                <button @onclick="() => Session.DevAddCoinsAsync(100)">+100 币</button>
                <button @onclick="ToggleSaveFailure">@(_failSaves ? "恢复保存" : "模拟保存失败")</button>
                <button @onclick="ResetPrefs">重置小窗</button>
            </div>
        }

        <div class="placeholder-note">
            <div>@Texts.TrialNote</div>
            <div>@Texts.FakeDesktopNote</div>
            @if (_loaded && Pet.State.Closed)
            {
                <div class="closed-note" data-note="closed">@Texts.ClosedState</div>
            }
        </div>

        <div class="taskbar" @onclick:stopPropagation="true">
            <button class="start" title="开始"><span></span><span></span><span></span><span></span></button>
            <button class="task @(_notepadOpen ? "open" : "")" title="记事本" @onclick="() => _notepadOpen = true">
                <span class="glyph notepad"></span>
            </button>
            <button class="task @(Pet.State.Closed ? "" : "open")" title="桌面摸鱼" data-game-ui="taskbar" @onclick="TaskbarPet">
                <img src="img/icon.svg" alt="" />
            </button>
            <div class="clock">@DateTime.Now.ToString("HH:mm")<br />@DateTime.Now.ToString("yyyy/M/d")</div>
        </div>
    </div>
</div>

@code {
    private ElementReference _desktop;
    private DotNetObjectReference<FakeDesktop>? _ref;
    private Timer? _clock;
    private bool _loaded;
    private bool _dev;
    private bool _pc;
    private (bool, bool, bool)? _pcSynced;
    private bool _quitting;
    private bool _failSaves;
    private string? _selectedIcon;
    private bool _notepadOpen = true;
    private int _notepadX = 300;
    private int _notepadY = 150;

    private PetController Pet => Session.Pet;

    private sealed record DeskIcon(string Id, string Label);

    private static readonly DeskIcon[] Icons =
    {
        new("computer", "此电脑"),
        new("trash", "回收站"),
        new("notepad", "记事本"),
        new("folder", "工作资料"),
        new("pet", "桌面摸鱼"),
    };

    private const string NotepadText =
        "今天的待办\n\n1. 整理周报\n2. 回复邮件\n3. 下午三点开会\n\n" +
        "（这是假桌面上的记事本，用来模拟“正在工作的软件”。\n小窗透明区穿透开着时，点到小窗留白处，点击会落到这里或桌面上。）";

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        _pc = Session.Pc = await JS.InvokeAsync<bool>("moyuPet.isPc");
        await Session.LoadAsync();
        // PC 版关闭就是退出程序，再启动时小窗照常打开
        if (_pc && Pet.State.Closed) Pet.Reopen();
        _loaded = true;
        _clock = new Timer(_ => InvokeAsync(StateHasChanged), null, 30000, 30000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pc && _loaded) await PcSyncAsync();
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("moyuPet.init", _ref, _desktop);
        await JS.InvokeVoidAsync("moyuPlay.init", _ref);
        await Session.NetInitAsync(_ref);
        _dev = await JS.InvokeAsync<bool>("moyuPet.isDev");
        if (!_dev) return;
        await JS.InvokeVoidAsync("moyuPlay.enableDev", _ref);
        StateHasChanged();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    // ---- PC 外壳（B4） ----

    /// <summary>渲染完把收起、置顶、穿透交给外壳；点了关闭就先停后台输入、存档，再退出程序（01 §5，PC 输入 §4.3）。</summary>
    private async Task PcSyncAsync()
    {
        if (Pet.State.Closed)
        {
            if (_quitting) return;
            _quitting = true;
            await JS.InvokeVoidAsync("moyuPet.pcQuitting");
            await Session.CommitPrefsAsync();
            await Session.SaveNowAsync();
            await JS.InvokeVoidAsync("moyuPet.pcQuit");
            return;
        }
        var now = (Pet.State.Collapsed, Pet.State.Settings.Topmost, Pet.State.Settings.Passthrough);
        if (_pcSynced == now) return;
        _pcSynced = now;
        await JS.InvokeVoidAsync("moyuPet.pcSync", now.Item1, now.Item2, now.Item3);
    }

    /// <summary>系统要关窗（Alt+F4、任务栏关闭）：和点关闭按钮一样。</summary>
    [JSInvokable]
    public Task OnPcClosing()
    {
        Pet.Close();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task Commit() => Session.CommitPrefsAsync();

    // ---- 工作输入与写权（js/play.js） ----

    [JSInvokable]
    public bool OnWorkInput() => Session.OnWorkInput();

    /// <summary>PC 后台输入的真实开关和状态（外壳推来）。</summary>
    [JSInvokable]
    public bool OnPcInput(bool on, string status, bool intro) => Session.OnPcInput(on, status, intro);

    [JSInvokable]
    public Task OnWriterGranted() => Session.OnWriterGrantedAsync();

    // ---- 联机（B9，js/net.js） ----

    [JSInvokable]
    public Task OnNet(string json) => Session.OnNetAsync(json);

    // ---- 开发入口（?dev=1，window.moyuDev） ----

    [JSInvokable]
    public Task DevInjectFish(int n) => Session.DevInjectFishAsync(n);

    [JSInvokable]
    public Task DevAddCoins(int n) => Session.DevAddCoinsAsync(n);

    [JSInvokable]
    public Task DevSaveFailureChanged(bool failing)
    {
        _failSaves = failing;
        return Session.DevSaveFailureChangedAsync(failing);
    }

    [JSInvokable]
    public string DevProfileJson() => Session.DevProfileJson();

    /// <summary>把手竿计时看到的"现在"再往后拨 ms 毫秒，返回累计拨了多少。</summary>
    [JSInvokable]
    public long DevSkew(long ms)
    {
        Session.DevSkewMs += ms;
        return Session.DevSkewMs;
    }

    /// <summary>马上做一次手竿计时检查（不等每秒那次）。</summary>
    [JSInvokable]
    public void DevPoleTick() => Session.PoleCheck();

    /// <summary>把上一条好友收获消息和一条旧代次消息再送一次，返回被接受了几条（应为 0）。</summary>
    [JSInvokable]
    public Task<int> DevRoomReplay() => Session.DevRoomReplayAsync();

    /// <summary>界面上这时点不到的房间演示：catch 好友收获、drop 成员断线、end 结束模拟；和演示控制走同一套方法。</summary>
    [JSInvokable]
    public async Task DevRoom(string action, string? id)
    {
        if (id != null) Session.SelectedMemberId = id;
        if (action == "catch") await Session.FriendCatchAsync();
        else if (action == "drop") Session.Disconnect();
        else if (action == "end") Session.EndSimulation();
        await Commit();
    }

    private async Task ToggleSaveFailure() => await JS.InvokeAsync<object>("moyuDev.failSaves", !_failSaves);

    [JSInvokable]
    public Task OnWindowMoved(double x, double y)
    {
        Pet.MoveWindow(x, y);
        return Commit();
    }

    [JSInvokable]
    public Task OnAvatarMoved(double x, double y)
    {
        Pet.MoveAvatar(x, y);
        return Commit();
    }

    [JSInvokable]
    public Task OnAvatarClicked()
    {
        Pet.Restore();
        return Commit();
    }

    private CancellationTokenSource? _noRoomCts;

    [JSInvokable]
    public async Task OnSceneClicked(string kind, double x, double y)
    {
        var result = Session.ClickScene(new ScenePoint(x, y));
        if (result == PlaceResult.NoRoom)
        {
            _noRoomCts?.Cancel();
            var cts = _noRoomCts = new CancellationTokenSource();
            Session.NoRoomAt = new ScenePoint(x, y);
            await Commit();
            try
            {
                await Task.Delay(1500, cts.Token);
                Session.NoRoomAt = null;
                StateHasChanged();
            }
            catch (TaskCanceledException) { }
            return;
        }
        if (result == PlaceResult.Placed) Session.NoRoomAt = null;
        await Commit();
    }

    private void SelectIcon(string id) => _selectedIcon = id;

    private void ClearIconSelection() => _selectedIcon = null;

    private Task OpenIcon(string id)
    {
        if (id == "notepad") _notepadOpen = true;
        if (id == "pet")
        {
            Pet.Reopen();
            return Commit();
        }
        return Task.CompletedTask;
    }

    private Task TaskbarPet()
    {
        if (Pet.State.Closed) Pet.Reopen();
        else if (Pet.State.Collapsed) Pet.Restore();
        else Pet.Collapse();
        return Commit();
    }

    private async Task ResetPrefs()
    {
        await JS.InvokeVoidAsync("moyuPet.save", "moyu.prefs.v1", "");
        await Session.ReloadPrefsAsync();
    }

    private static string Px(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "px";

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        _clock?.Dispose();
        _ref?.Dispose();
    }
}

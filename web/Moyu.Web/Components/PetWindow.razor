@* 16:9 透明小窗。外层是桌面逻辑像素（480×270），里层按 1600×900 设计稿排版后整体缩放。
   穿透开（默认）：外层不接指针，只有画出来的实体（岸、水、角色、按钮、面板）接；
   穿透关：外层也接指针，留白点了没反应、仍然透明（DEC-09）。 *@
<div id="pet" class="pet @(Pet.State.Settings.Passthrough ? "" : "capture")" style="@WindowStyle">
    <div class="design" style="@DesignStyle">
        <PetScene Session="Session" />

        <div class="topbar">
            <button class="pill purple solid @(Pet.State.Panel == Panel.Room ? "on" : "")" title="房间" @onclick="() => Toggle(Panel.Room)">
                <Icon Name="people" /><span>房间</span>
            </button>
            <button class="pill purple solid round" title="@(Pet.State.Settings.Mute ? "取消静音" : "静音")" @onclick="ToggleMute">
                <Icon Name="@(Pet.State.Settings.Mute ? "mute" : "sound")" />
            </button>
            <button class="pill solid round" title="收起" @onclick="Collapse"><Icon Name="minus" /></button>
            <button class="pill solid round" title="关闭" @onclick="Close"><Icon Name="close" /></button>
        </div>

        <PetPanels Session="Session" OnChanged="Commit" />

        <div class="bottombar solid">
            <button class="pill lime mode" @onclick="() => Toggle(Panel.ModeMenu)">
                <Icon Name="@ModeIcon(Pet.State.Mode)" /><span>@ModeName(Pet.State.Mode)</span><Icon Name="caret" Class="caret" />
            </button>
            @* 常驻数字：总累计、本轮进度、金币、保存状态（02 §1、WU-01）。悬停看完整整数。 *@
            <div class="stats" aria-live="polite">
                <span class="stat" data-stat="total" title="@Texts.TotalTitle(Play?.Profile.LifetimeInputs ?? 0)"><i>总</i>@Short(Play?.Profile.LifetimeInputs ?? 0)</span>
                <span class="stat cycle" data-stat="cycle" title="@CycleTitle"><i>本轮</i>@CycleText</span>
                <span class="stat" data-stat="coins" title="@Texts.CoinsTitle(Play?.Profile.Coins ?? 0)"><i>金币</i><span class="coin"></span>@Short(Play?.Profile.Coins ?? 0)</span>
                <span class="stat save @Session.State.ToString().ToLowerInvariant()" data-stat="save" data-reason="@Session.LoadError" title="@SaveTitle">@SaveText</span>
            </div>
            <button class="pill tab @On(Panel.Basket)" title="鱼篓" @onclick="() => Toggle(Panel.Basket)">
                <Icon Name="basket" />
                @* 新鱼数量：和头顶卡片来自同一次已保存的捕获，打开鱼篓看过才清（02 §2.1） *@
                @if (Session.NewFishCount > 0)
                {
                    <span class="badge" data-stat="new-fish" title="@Texts.NewFishTitle(Session.NewFishCount)">@Session.NewFishCount</span>
                }
            </button>
            <button class="pill tab @On(Panel.Collection)" title="收藏" @onclick="() => Toggle(Panel.Collection)"><Icon Name="star" /></button>
            <button class="pill tab @On(Panel.Records)" title="记录" @onclick="() => Toggle(Panel.Records)"><Icon Name="list" /></button>
            <button class="pill tab @(MoreOn ? "on" : "")" title="更多" @onclick="() => Toggle(Panel.More)"><Icon Name="gear" /></button>
        </div>
    </div>
    @if (Pc)
    {
        @* PC 右下角缩放热区：只改窗口大小，保持 16:9（05 §6.1）；网页版没有（TECH-26） *@
        <div class="pc-resize" data-hit="resize"></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public PetSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnCommit { get; set; }
    /// <summary>PC 版：小窗填满外壳窗口，按窗口宽缩放设计稿（js/pet.js 写 --pc-scale）。</summary>
    [Parameter] public bool Pc { get; set; }

    private PetController Pet => Session.Pet;
    private PlayEngine? Play => Session.Play;

    private string WindowStyle => Pc
        ? "left:0;top:0;width:100%;height:100%"
        : $"left:{Px(Pet.State.Window.X)};top:{Px(Pet.State.Window.Y)};width:{Px(Pet.Layout.WindowWidth)};height:{Px(Pet.Layout.WindowHeight)}";

    private string DesignStyle => Pc
        ? "transform:scale(var(--pc-scale, 0.3))"
        : $"transform:scale({F(Pet.Layout.WindowWidth / SceneCanvas.Width)})";

    // 底栏文字按文案定稿 TXT-STAT（Texts）
    private string CycleText
    {
        get
        {
            if (Play == null) return "—";
            var mode = Pet.State.Mode;
            var next = Play.NextNode(mode, Pet.State.MapId);
            if (next == null) return Texts.PoleShort(Play.PoleElapsed(Pet.State.MapId)); // 手竿：本图真实已过时间/30:00
            var count = Play.CycleCount(mode, Pet.State.MapId);
            return $"{count}/{next}" + (next == CaptureRules.For(mode)!.GuaranteedNode ? " 保底" : "");
        }
    }

    private string CycleTitle
    {
        get
        {
            if (Play == null) return "";
            var map = Pet.State.MapId;
            if (Play.NextNode(Pet.State.Mode, map) is { } next) return Texts.CycleTitle(Play.CycleCount(Pet.State.Mode, map), next);
            long ms = Play.PoleElapsed(map);
            var lines = new List<string>
            {
                Session.PoleTimingMap == map ? Texts.PoleRunning(ms) : Texts.PolePaused(ms),
                Texts.PoleRules,
                Texts.PoleGapRule,
            };
            if (Session.PoleGapExcluded) lines.Add(Texts.PoleGapHappened);
            return string.Join("\n", lines);
        }
    }

    private string SaveTitle => Session.State switch
    {
        SaveState.Loading => Texts.NotReady,
        SaveState.Unsaved => Texts.SaveRetry,
        SaveState.ReadOnly => Texts.ReadOnlyPage,
        SaveState.LoadError => Session.LoadError == "存档版本不认识" ? Texts.UnknownVersion : Texts.LoadFailed,
        _ => SaveText,
    };

    private string SaveText => Session.State switch
    {
        SaveState.Loading => "读档中",
        SaveState.Saved => "已保存",
        SaveState.Saving => "保存中",
        SaveState.Unsaved => "未保存",
        SaveState.ReadOnly => "只读",
        _ => "读档失败",
    };

    /// <summary>底栏放不下长数字：一万以上缩成"万"，完整数在悬停提示里。</summary>
    private static string Short(long n) => n < 10000 ? n.ToString() : (n / 1000 / 10.0).ToString("0.#") + "万";

    public static string ModeName(FishingMode m) => Texts.ModeName(m);

    public static string ModeIcon(FishingMode m) => m switch
    {
        FishingMode.Lure => "rod",
        FishingMode.Wade => "hand",
        _ => "pole",
    };

    private string On(Panel p) => Pet.State.Panel == p ? "on" : "";
    private bool MoreOn => Pet.State.Panel is Panel.More or Panel.Map or Panel.Skin or Panel.Settings;

    private Task Toggle(Panel p)
    {
        // 地图/皮肤/设置是从"更多"进去的，此时再点"更多"就关掉
        if (p == Panel.More && MoreOn && Pet.State.Panel != Panel.More) Pet.ClosePanel();
        else Pet.TogglePanel(p);
        return Commit();
    }

    private Task ToggleMute()
    {
        Pet.SetMute(!Pet.State.Settings.Mute);
        return Commit();
    }

    private Task Collapse()
    {
        Pet.Collapse();
        return Commit();
    }

    private Task Close()
    {
        Pet.Close();
        return Commit();
    }

    private Task Commit() => OnCommit.InvokeAsync();

    private static string F(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private static string Px(double v) => F(v) + "px";
}
